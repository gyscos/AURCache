# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb


*.env

# Persistent on-disk git checkout cache for SnapshotStore (AURCACHE_SOURCE_CACHE_PATH)
source_cache/

# Build output of the Rust frontend (wasm bundle + wasm-bindgen glue).
# Produced by `cargo build --target wasm32-unknown-unknown` + `wasm-bindgen`.
frontend-rs/dist/

# The built frontend, embedded into the server by `aurcache-api`'s `static`
# feature. Produced by the Docker build and by scripts/test-frontend.sh; never
# a source file.
backend/aurcache-api/web/
